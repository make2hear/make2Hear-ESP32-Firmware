# Public configuration: a fresh checkout must build without a saved sdkconfig.
CONFIG_IDF_TARGET="esp32"
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_EXAMPLE_PEER_DEVICE_NAME="B3"
CONFIG_EXAMPLE_SSP_ENABLED=y
CONFIG_MAKE2HEAR_DEVICE_NAME="Make2Hear"
CONFIG_MAKE2HEAR_MIC_BCLK=26
CONFIG_MAKE2HEAR_MIC_WS=25
CONFIG_MAKE2HEAR_MIC_DATA=33
CONFIG_MAKE2HEAR_MIC_RIGHT_SLOT=n
CONFIG_MAKE2HEAR_GAIN_2X=y
CONFIG_MAKE2HEAR_STATS_PERIOD_MS=1000
